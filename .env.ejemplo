# ─── Copie este archivo como .env y ponga su llave ───

# 1) LLAVE DE GEMINI (gratis en aistudio.google.com → Get API key)
#    Sin ella la app funciona igual con el intérprete local,
#    pero con ella el agente entiende muchas más variantes de frase.
GOOGLE_API_KEY=
MODELO=gemini-flash-latest

# 2) Base de datos (docker-compose la sobreescribe; para modo local déjela así)
DB_URL=sqlite:///cuentavoz.db

# 3) Reglas del negocio
IDIOMA_VOZ=es-CO
UMBRAL_ANOMALIA=0.5          # 0.5 = 50 % de desviación dispara la alerta

# 4) Seguridad - identidad con AWS Cognito (registro/login/clave los
#    maneja el frontend hablando directo con Cognito; el backend solo
#    verifica el access token y administra cuentas via boto3)
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# credenciales de una cuenta IAM propia del backend (AdminUserGlobalSignOut,
# AdminCreateUser, AdminSetUserPassword, AdminGetUser sobre ese User Pool
# nada mas) - NUNCA la cuenta usada para crear el User Pool
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Crea luis/diana/stephanie/valentina (clave StockXperts1) si la base de
# usuarios esta vacia - util en local/demo. NO active esto en un
# despliegue con datos reales: diana tiene perfil auditor (administrador).
SEMBRAR_DEMO=1
# uno o varios origenes separados por coma (el/los dominio(s) del frontend)
ORIGEN_PERMITIDO=http://localhost:5173

# 5) Monitoreo de errores (opcional) - sin esto la app funciona igual,
#    solo no reporta errores de produccion a ningun lado. DSN de un
#    proyecto en sentry.io (ver DESPLIEGUE.md para el paso a paso). El
#    equivalente del frontend, VITE_SENTRY_DSN, se pone en Render (o en un
#    frontend/.env local) - igual que ya se hace con VITE_API_URL, Vite
#    solo lee variables VITE_* en tiempo de build, no desde este archivo.
SENTRY_DSN=
